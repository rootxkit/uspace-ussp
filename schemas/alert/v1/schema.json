{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.uspace.ge/alert/v1.json",
  "title": "alert/v1",
  "description": "One alert of a USSP monitor (spec 04 §3.3; Reg. (EU) 2021/664 Art. 11, 13) in the common envelope (04 §2): on alrt.v1.<kind>.<cell5>.<alert_id> from monitor to api (the alerts record) and traffic-ws, and as a body of WS /v1/alerts, WS /v1/traffic and traffic/product/v1. An alert is raised once, updated (republished every second with its current numbers while it holds, C-08) and cleared with a reason (C-06, C-14). A proximity alert is the national CPA addition: one per flight of this USSP in the pair, naming the other aircraft (peer), both sides carrying the numbers of the same judgement (C-11). The alert informs; it never carries resolution advice (2021/664 Art. 11(4), LESSONS X-15). alert_id is a UUID derived from the condition and its raise time, so a republish, a restart and a handover name the same alert.",
  "allOf": [
    {
      "$ref": "https://schemas.uspace.ge/envelope/v1.json"
    }
  ],
  "properties": {
    "schema": {
      "const": "alert/v1"
    },
    "body": {
      "$ref": "#/$defs/body"
    }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "time": {
      "type": "string",
      "format": "date-time"
    },
    "nullable_time": {
      "oneOf": [
        {
          "$ref": "#/$defs/time"
        },
        {
          "type": "null"
        }
      ]
    },
    "trust": {
      "description": "Trust class (04 §2). Pinned to uspace-core `core.Trust`.",
      "enum": [
        "authenticated",
        "provider",
        "surveillance",
        "broadcast",
        "sensor",
        "simulated"
      ]
    },
    "peer": {
      "description": "The other aircraft of a proximity alert: its track id (a flight id, a peer's flight id or an icao24) and its trust class, shown as such (R-05: a broadcast track is always labelled broadcast).",
      "type": "object",
      "required": [
        "track_id",
        "trust"
      ],
      "properties": {
        "track_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "trust": {
          "$ref": "#/$defs/trust"
        },
        "source": {
          "description": "Adapter type the peer was heard from (04 §2).",
          "enum": [
            "operator_ws",
            "network_rid",
            "direct_rid",
            "ansp_feed",
            "adsb_rx",
            "sitl"
          ]
        }
      }
    },
    "proximity_detail": {
      "description": "The CPA numbers of the last judgement that showed the conflict true (uspace-core cpa and alerting): t_cpa_s (time to the closest point of approach, 0 when diverging), d_cpa_h_m (horizontal distance at it), d_alt_m (vertical separation at it, AMSL; null when the vertical is not known, R-09), the peer, and beside them d_horizontal_now_m, vertical_separation_known, los_start_s (time to the loss of separation, 0 when inside the minima now; the ranking of active conflicts, C-19), pair_id (the same on both flights' alerts) and evaluation_period_s (1 s, or 2 s above the pair budget, spec 05 §5).",
      "type": "object",
      "required": [
        "t_cpa_s",
        "d_cpa_h_m",
        "d_alt_m",
        "peer",
        "evaluation_period_s"
      ],
      "properties": {
        "t_cpa_s": {
          "type": "number",
          "minimum": 0
        },
        "d_cpa_h_m": {
          "type": "number",
          "minimum": 0
        },
        "d_alt_m": {
          "type": [
            "number",
            "null"
          ]
        },
        "d_horizontal_now_m": {
          "type": "number",
          "minimum": 0
        },
        "vertical_separation_known": {
          "type": "boolean"
        },
        "los_start_s": {
          "type": "number",
          "minimum": 0
        },
        "peer": {
          "$ref": "#/$defs/peer"
        },
        "pair_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{24}$"
        },
        "evaluation_period_s": {
          "description": "1 s, or 2 s above the pair budget; never more (spec 05 §5).",
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 2
        },
        "carried_since": {
          "description": "Set while the alert is carried across a monitor restart, a handover or a policy change and not yet judged again.",
          "$ref": "#/$defs/time"
        }
      }
    },
    "body": {
      "type": "object",
      "required": [
        "alert_id",
        "kind",
        "severity",
        "state",
        "clear_reason",
        "flight_id",
        "intent_id",
        "authorisation_number",
        "captured_at",
        "raised_at",
        "updated_at",
        "policy_version",
        "detail"
      ],
      "properties": {
        "alert_id": {
          "$ref": "#/$defs/uuid"
        },
        "kind": {
          "description": "04 §3.3, and uspace-core alerting's two identification kinds (identification: an unidentified or unknown-operator aircraft inside a PROHIBITED or REQ_AUTHORIZATION zone, G-03; identification_mismatch, G-02; brief WP-12).",
          "enum": [
            "proximity",
            "nonconformance",
            "nonconformance_nearby",
            "height_exceedance",
            "zone_incursion",
            "lost_link",
            "restriction_activated",
            "emergency_nearby",
            "identification",
            "identification_mismatch"
          ]
        },
        "severity": {
          "enum": [
            "info",
            "warning",
            "critical"
          ]
        },
        "state": {
          "enum": [
            "raised",
            "updated",
            "cleared"
          ]
        },
        "clear_reason": {
          "description": "Why a cleared alert cleared; null otherwise. resolved rests on evidence (shown false for longer than the hysteresis); stale on silence; source_disabled on a switch; landed on a not-flying sample; flight_ended on the flight's end; not_reconfirmed on an alert carried across a restart that was not judged in conflict again; acknowledged_timeout as 04 §3.3 names it.",
          "oneOf": [
            {
              "enum": [
                "resolved",
                "stale",
                "source_disabled",
                "landed",
                "flight_ended",
                "not_reconfirmed",
                "acknowledged_timeout"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "flight_id": {
          "description": "The flight of this USSP the alert is about; null only for a restriction_activated alert of an intent that has no flight yet (an accepted intent a restriction withdrew before its activation, brief WP-12).",
          "oneOf": [
            {
              "$ref": "#/$defs/uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "intent_id": {
          "oneOf": [
            {
              "$ref": "#/$defs/uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "authorisation_number": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 64
        },
        "captured_at": {
          "description": "The placement of the triggering sample (04 §2).",
          "$ref": "#/$defs/time"
        },
        "raised_at": {
          "$ref": "#/$defs/time"
        },
        "updated_at": {
          "$ref": "#/$defs/time"
        },
        "policy_version": {
          "type": "integer",
          "minimum": 0
        },
        "detail": {
          "description": "The numbers of the kind (04 §3.3); a proximity alert's are proximity_detail.",
          "type": "object"
        },
        "clearing_detail": {
          "description": "On a clear: the numbers of the judgement that cleared it (C-14), or why a carried alert ended.",
          "type": "object"
        },
        "acked_at": {
          "description": "When the operator acknowledged it (POST /v1/alerts/{alert_id}/ack); null or absent until then.",
          "$ref": "#/$defs/nullable_time"
        },
        "escalated_at": {
          "description": "When an unacknowledged critical alert was escalated to the supervisor console (02 F5); null or absent until then.",
          "$ref": "#/$defs/nullable_time"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "cleared"
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "properties": {
              "clear_reason": {
                "type": "string"
              }
            }
          },
          "else": {
            "properties": {
              "clear_reason": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "proximity"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "detail": {
                "$ref": "#/$defs/proximity_detail"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "zone_incursion"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "detail": {
                "$ref": "#/$defs/zone_incursion_detail"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "restriction_activated"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "detail": {
                "$ref": "#/$defs/restriction_activated_detail"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "not": {
                  "const": "restriction_activated"
                }
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "flight_id": {
                "$ref": "#/$defs/uuid"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "flight_id": {
                "type": "null"
              }
            },
            "required": [
              "flight_id"
            ]
          },
          "then": {
            "properties": {
              "intent_id": {
                "$ref": "#/$defs/uuid"
              }
            }
          }
        }
      ]
    },
    "zone_incursion_detail": {
      "description": "A zone incursion as uspace-core's alerting.Monitor judged it (zones.JudgeVertical, spec 04 §3.3): the zone's id and ED-318 type, the dataset and versions it was published in, and core's vertical judgement: vertical_known (false for a pressure altitude or an unjudged limit), limit_not_judged with not_judged naming the references (AGL without terrain, WGS84 without a geoid, SC-13), within_band for a pressure altitude. The severity is core's per type, never above the zone's restriction (Z-10).",
      "type": "object",
      "required": [
        "zone_id",
        "zone_type",
        "vertical_known",
        "limit_not_judged"
      ],
      "properties": {
        "zone_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "zone_type": {
          "enum": [
            "PROHIBITED",
            "REQ_AUTHORIZATION",
            "CONDITIONAL"
          ]
        },
        "zone_part": {
          "type": "string"
        },
        "dataset": {
          "enum": [
            "zones",
            "restrictions"
          ]
        },
        "zone_version": {
          "type": "string"
        },
        "cis_version": {
          "type": "string"
        },
        "restriction_state": {
          "type": "string"
        },
        "vertical_known": {
          "type": "boolean"
        },
        "limit_not_judged": {
          "type": "boolean"
        },
        "within_band": {
          "type": "boolean"
        },
        "not_judged": {
          "type": "array",
          "items": {
            "enum": [
              "AGL",
              "WGS84"
            ]
          }
        },
        "height_agl_m": {
          "type": "number"
        },
        "alt_hae_m": {
          "type": "number"
        },
        "carried_since": {
          "$ref": "#/$defs/time"
        }
      }
    },
    "restriction_activated_detail": {
      "description": "The standing re-check of 2021/664 Art. 10(10) (brief WP-12): a restriction, a zone or a U-space airspace published or changed after the intent was authorised meets the intent's volumes. cause names it (restriction, zone, uspace_airspace, priority); ref is the feature or the intent; decision says what this USSP did: withdrawn (an accepted intent not yet activated: its local state is withdrawn) or marked (an activated one: it stays activated, conformance keeps judging the flight, and its authorisation no longer stands for the window). withdrawn is true when the authorisation no longer stands; authorisation_updated is false (an update is the operator's new request). window is when the conflict applies. No advice: the remote pilot decides (Art. 11(4)).",
      "type": "object",
      "required": [
        "cause",
        "ref",
        "decision",
        "withdrawn",
        "authorisation_updated",
        "affected_intents",
        "window",
        "change_reason"
      ],
      "properties": {
        "cause": {
          "enum": [
            "restriction",
            "zone",
            "uspace_airspace",
            "priority"
          ]
        },
        "ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "restriction_id": {
          "type": "string"
        },
        "by_intent_id": {
          "$ref": "#/$defs/uuid"
        },
        "reason": {
          "type": "string"
        },
        "decision": {
          "enum": [
            "withdrawn",
            "marked"
          ]
        },
        "withdrawn": {
          "type": "boolean"
        },
        "authorisation_updated": {
          "const": false
        },
        "previous_state": {
          "type": "string"
        },
        "intent_state": {
          "type": "string"
        },
        "affected_intents": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/uuid"
          }
        },
        "window": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "required": [
                "starts_at",
                "ends_at"
              ],
              "properties": {
                "starts_at": {
                  "$ref": "#/$defs/nullable_time"
                },
                "ends_at": {
                  "$ref": "#/$defs/nullable_time"
                }
              }
            }
          ]
        },
        "conflicts": {
          "type": "array"
        },
        "change_reason": {
          "type": "string",
          "minLength": 1
        },
        "cis_version": {
          "type": "string"
        }
      }
    }
  }
}
