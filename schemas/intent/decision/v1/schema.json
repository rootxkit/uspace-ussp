{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.uspace.ge/intent/decision/v1.json",
  "title": "intent/decision/v1",
  "description": "The USSP's decision on an intent and the intent's state (spec 04 §3.5, 2021/664 Art. 10): the answer of POST, GET and PATCH /v1/intents (api/openapi.yaml). decision is authorised (with the authorisation number of Art. 10(11) and the deviation thresholds of Art. 10(2)(d)), accepted_voluntary (out of the regulation's scope, Art. 1(3): no number), rejected, or held pending_validation (registry), pending_authority (a zone requiring an authorisation) or pending_dss (inside U-space airspace while the DSS cannot be written). conflicts[] name what refused, held or was flagged: the Annex IV item, the zone, airspace, restriction, intent or registry key, our volume and the overlap; a refusal never rests on a problem body. alternative is always null in v1. The USSP informs: nothing here is a resolution advice.",
  "type": "object",
  "additionalProperties": false,
  "required": ["intent_id", "version", "client_ref", "decision", "state", "dss_state", "authorisation_number", "exempt_art_1_3",
    "in_uspace_airspace", "uspace_airspace_ids", "priority", "deviation_thresholds", "alternative", "conflicts", "conditions",
    "volumes_amsl", "valid_from", "valid_to", "cis_version_checked", "cis_age_s", "registry_checked_at", "policy_version",
    "weather_checked_ref", "change_reason", "decided_at", "updated_at"],
  "properties": {
    "intent_id": { "description": "UUID, also the DSS entity id.", "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
    "version": { "type": "integer", "minimum": 1 },
    "client_ref": { "type": "string" },
    "decision": { "enum": ["authorised", "accepted_voluntary", "rejected", "pending_validation", "pending_authority", "pending_dss"] },
    "state": { "enum": ["pending_validation", "pending_dss", "pending_authority", "accepted", "activated", "nonconforming", "contingent", "ended", "rejected", "withdrawn"] },
    "dss_state": { "description": "F3548 state of the intent, null when it is not one the DSS holds.", "enum": ["Accepted", "Activated", "Nonconforming", "Contingent", null] },
    "authorisation_number": {
      "description": "<USSP code>-<operator registration public part>-<ULID> (spec 03 §6); null unless authorised.",
      "type": ["string", "null"], "pattern": "^[A-Z0-9-]{1,16}-[A-Za-z0-9-]{1,64}-[0-7][0-9A-HJKMNP-TV-Z]{25}$"
    },
    "exempt_art_1_3": { "type": "boolean" },
    "in_uspace_airspace": { "type": "boolean" },
    "uspace_airspace_ids": { "type": "array", "items": { "type": "string" } },
    "priority": { "type": "integer", "minimum": 0 },
    "deviation_thresholds": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object", "additionalProperties": false, "required": ["h_m", "v_m", "t_s"],
          "properties": {
            "h_m": { "type": "number", "exclusiveMinimum": 0 },
            "v_m": { "type": "number", "exclusiveMinimum": 0 },
            "t_s": { "type": "number", "exclusiveMinimum": 0 }
          }
        }
      ]
    },
    "alternative": { "description": "Art. 10(4) proposal; none in v1.", "type": "null" },
    "conflicts": { "type": "array", "items": { "$ref": "#/$defs/conflict" } },
    "conditions": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["code", "detail"],
        "properties": {
          "code": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "ref": { "type": "string" },
          "detail": { "type": "string" }
        }
      }
    },
    "volumes_amsl": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["lower_amsl_m", "upper_amsl_m", "undulation_m", "lower_w84_m", "upper_w84_m"],
        "properties": {
          "lower_amsl_m": { "type": "number" }, "upper_amsl_m": { "type": "number" }, "undulation_m": { "type": "number" },
          "lower_w84_m": { "type": "number" }, "upper_w84_m": { "type": "number" }
        }
      }
    },
    "valid_from": { "type": "string", "format": "date-time" },
    "valid_to": { "type": "string", "format": "date-time" },
    "cis_version_checked": { "description": "The CIS versions the decision rests on, one label per ED-318 dataset; null when the CIS was not consulted.", "type": ["string", "null"] },
    "cis_age_s": { "type": ["number", "null"], "minimum": 0 },
    "registry_checked_at": { "type": ["string", "null"], "format": "date-time" },
    "policy_version": { "type": "integer", "minimum": 0 },
    "weather_checked_ref": { "description": "Art. 10(3); null until weather (WP-16).", "type": ["string", "null"] },
    "change_reason": { "type": ["string", "null"] },
    "decided_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "conflict": {
      "type": "object", "additionalProperties": false, "required": ["kind", "reason", "effect", "item", "volume", "overlap", "detail"],
      "properties": {
        "kind": { "enum": ["annex_iv", "registry", "cis", "airspace", "zone", "restriction", "intent", "policy", "dss"] },
        "reason": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "effect": { "enum": ["rejects", "holds", "flags_other"] },
        "ref": { "type": "string" },
        "item": { "description": "The Annex IV item number, null when the conflict is not about one.", "type": ["integer", "null"], "minimum": 1, "maximum": 10 },
        "volume": { "description": "Index of our volume.", "type": ["integer", "null"], "minimum": 0 },
        "overlap": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object", "additionalProperties": false, "required": ["h_m", "v_m", "t_s"],
              "properties": {
                "h_m": { "description": "Horizontal separation, 0 when the outlines meet; null when not judged.", "type": ["number", "null"] },
                "v_m": { "description": "Vertical overlap in AMSL; null when a limit is not AMSL.", "type": ["number", "null"] },
                "t_s": { "description": "Common time in seconds.", "type": ["number", "null"] }
              }
            }
          ]
        },
        "detail": { "type": "string" }
      }
    }
  }
}
