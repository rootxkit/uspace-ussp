{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.uspace.ge/track/telemetry/v1.json",
  "title": "track/telemetry/v1",
  "description": "One picture track (spec 04 §3.1) with its identification block (04 §3.2), in the common envelope. Produced by several systems (decision record M14), so it lives in uspace-lab/schemas/common/. Field names are those of 04 §3.1 and §3.2 and of uspace-core `core.Identification`.",
  "allOf": [{ "$ref": "https://schemas.uspace.ge/envelope/v1.json" }],
  "properties": {
    "schema": { "const": "track/telemetry/v1" },
    "body": { "$ref": "#/$defs/body" }
  },
  "$defs": {
    "nullable_number": { "type": ["number", "null"] },
    "nullable_nonnegative": {
      "oneOf": [{ "type": "number", "minimum": 0 }, { "type": "null" }]
    },
    "nullable_string": { "type": ["string", "null"] },
    "body": {
      "type": "object",
      "required": [
        "track_id", "trust", "source", "source_instance", "position",
        "alt_wgs84_m", "alt_amsl_m", "alt_source", "alt_pressure_m",
        "height_m", "height_ref", "speed_ms", "track_deg", "vspeed_ms",
        "accuracy_h_m", "accuracy_v_m", "status", "emergency",
        "identification", "flight_id", "intent_id"
      ],
      "properties": {
        "track_id": { "type": "string", "minLength": 1 },
        "trust": { "$ref": "https://schemas.uspace.ge/envelope/v1.json#/$defs/trust" },
        "source": { "$ref": "https://schemas.uspace.ge/envelope/v1.json#/$defs/source" },
        "source_instance": {
          "description": "The adapter instance: client id, receiver id or provider id (04 §2).",
          "type": "string",
          "minLength": 1
        },
        "position": {
          "description": "WGS84 decimal degrees (02 §1).",
          "type": "object",
          "required": ["lat", "lng"],
          "properties": {
            "lat": { "type": "number", "minimum": -90, "maximum": 90 },
            "lng": { "type": "number", "minimum": -180, "maximum": 180 }
          }
        },
        "alt_wgs84_m": { "$ref": "#/$defs/nullable_number" },
        "alt_amsl_m": { "$ref": "#/$defs/nullable_number" },
        "alt_source": {
          "description": "Which rule produced the AMSL altitude. Pinned to uspace-core `core.AltSource`.",
          "enum": ["geodetic", "pressure", "network", "none"]
        },
        "alt_pressure_m": {
          "description": "Pressure altitude, ISA 1013.25 hPa; not AMSL (04 §3.1).",
          "$ref": "#/$defs/nullable_number"
        },
        "height_m": { "$ref": "#/$defs/nullable_number" },
        "height_ref": {
          "description": "F3411 height reference; required whenever `height_m` is a number (02 §1: altitudes with explicit reference).",
          "enum": ["TakeoffLocation", "GroundLevel", null]
        },
        "speed_ms": { "$ref": "#/$defs/nullable_nonnegative" },
        "track_deg": {
          "description": "Degrees true, [0, 360).",
          "oneOf": [{ "type": "number", "minimum": 0, "exclusiveMaximum": 360 }, { "type": "null" }]
        },
        "vspeed_ms": { "$ref": "#/$defs/nullable_number" },
        "accuracy_h_m": { "$ref": "#/$defs/nullable_nonnegative" },
        "accuracy_v_m": { "$ref": "#/$defs/nullable_nonnegative" },
        "status": {
          "description": "F3411 operational status (uas_standards f3411 v22a `RIDOperationalStatus`).",
          "enum": ["Undeclared", "Ground", "Airborne", "Emergency", "RemoteIDSystemFailure", null]
        },
        "emergency": { "type": "boolean" },
        "identification": { "$ref": "#/$defs/identification" },
        "flight_id": { "$ref": "#/$defs/nullable_string" },
        "intent_id": { "$ref": "#/$defs/nullable_string" },
        "cell": {
          "description": "Partition cell `c5:<lat_idx>:<lon_idx>` (decision record M35; uspace-core WP-15 `geodesy/cell`: lat_idx = floor((lat + 90) / 0.1) in [0, 1799], lon_idx = floor((lng + 180) / 0.1) in [0, 3599], no leading zeros). Present on systems that partition (authority, USSP); absent elsewhere.",
          "type": "string",
          "pattern": "^c5:(0|[1-9][0-9]{0,2}|1[0-7][0-9]{2}):(0|[1-9][0-9]{0,2}|[12][0-9]{3}|3[0-5][0-9]{2})$"
        }
      },
      "if": {
        "properties": { "height_m": { "type": "number" } },
        "required": ["height_m"]
      },
      "then": {
        "properties": { "height_ref": { "enum": ["TakeoffLocation", "GroundLevel"] } }
      }
    },
    "identification": {
      "description": "Spec 04 §3.2; uspace-core `core.Identification`. Carried inside every track/telemetry/v1.",
      "type": "object",
      "required": ["status", "reason", "serial", "operator_reg", "registered_operator_reg", "mismatch", "basis"],
      "properties": {
        "status": {
          "description": "Pinned to uspace-core `core.IdentStatus`.",
          "enum": ["registered", "suspended", "unknown_operator", "unidentified"]
        },
        "reason": {
          "description": "Pinned to uspace-core `core.IdentReason`.",
          "enum": [
            "matched", "session_binding", "uas_suspended", "uas_revoked",
            "operator_suspended", "operator_revoked", "serial_unknown",
            "not_a_serial", "operator_absent", "operator_mismatch",
            "owner_unknown", "not_in_registry", "serial_conflict",
            "no_serial", "registry_unavailable"
          ]
        },
        "serial": {
          "description": "As broadcast or bound.",
          "$ref": "#/$defs/nullable_string"
        },
        "operator_reg": {
          "description": "As broadcast (public part compared case-insensitively).",
          "$ref": "#/$defs/nullable_string"
        },
        "registered_operator_reg": {
          "description": "The registered owner's number when it differs from the broadcast one (public part only).",
          "$ref": "#/$defs/nullable_string"
        },
        "mismatch": { "type": "boolean" },
        "registry_uas_id": { "$ref": "#/$defs/nullable_string" },
        "basis": {
          "description": "`authenticated` (USSP session), `as_broadcast` (\"as broadcast and unverified\") or `provider` (a Display Provider or F3548 peer's claim; decision record Q-A8, uspace-core v1.1.0 `core.BasisProvider`, pending in v1.0.0).",
          "enum": ["authenticated", "as_broadcast", "provider"]
        }
      },
      "if": {
        "properties": { "reason": { "const": "serial_conflict" } },
        "required": ["reason"]
      },
      "then": {
        "description": "04 §3.2: `mismatch` is true for serial_conflict.",
        "properties": { "mismatch": { "const": true } }
      }
    }
  }
}
