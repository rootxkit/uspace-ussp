{
  "name": "uspace-ussp-web",
  "version": "0.1.0",
  "private": true,
  "description": "The USSP's operator portal (and, from WP-18, its console): Next.js on uspace-ui. Renders what the API says, never judges.",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --max-warnings 0 .",
    "typecheck": "next typegen && tsc --noEmit",
    "gen:api": "uspace-ui-gen-api ../api/openapi.yaml src/api/generated/openapi.d.ts",
    "check:api": "uspace-ui-gen-api ../api/openapi.yaml src/api/generated/openapi.d.ts --check",
    "check:i18n": "node scripts/check-i18n.mjs",
    "test:e2e": "node e2e/serve.mjs --prepare && playwright test"
  },
  "dependencies": {
    "@rootxkit/uspace-ui": "https://github.com/rootxkit/uspace-ui/releases/download/v0.1.0/rootxkit-uspace-ui-0.1.0.tgz",
    "maplibre-gl": "5.24.0",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.89.0",
    "server-only": "0.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "axe-core": "4.13.0",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0"
  },
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22"
  }
}
