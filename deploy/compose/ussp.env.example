# The operator's settings of uspace-ussp on staging and in production:
# the env file every process of deploy/compose/staging.yaml reads
# (USSP_SETTINGS_FILE). Copy it outside the checkout, mode 600, and fill
# it. It holds no secret: passwords, DSNs and keys are in the secrets
# directory (deploy/gen-secrets.sh), and a secret written here is refused
# by deploy.sh.
#
# deploy/ENV.md is the catalogue (readers, default, unit, meaning); every
# variable it lists appears below, either set or commented out with its
# default, and `make check-deploy` fails when one is missing. ${USSP_HOST}
# and the peers' hosts come from the deployment env (deploy/staging/
# hosts.env on the droplet), interpolated by compose.
#
# GCAA has not answered its policy questions (docs/PLAN.md §15.2). Values
# marked "pending GCAA" are the spec's defaults, kept in configuration so
# that an answer is a change here, not in code. The national policy
# figures themselves (deviation thresholds, lost link, CPA, weather
# stations, record retention) are the policy row in the database, shown
# with its version on the console, not variables.
#
# Set by staging.yaml or the secrets directory, never here (the compose
# value wins over this file):
#   USSP_API_ADDR, USSP_TELEMETRY_INGEST_ADDR, USSP_RID_SP_ADDR,
#   USSP_MONITOR_ADDR, USSP_TRAFFIC_WS_ADDR, USSP_DSS_SYNC_ADDR,
#   USSP_TSDB_WRITER_ADDR                 the listeners Caddy and the probes use
#   USSP_TRUSTED_PROXIES                  the edge Caddy's and web's addresses only
#   USSP_ISSUER_KEY_FILE, USSP_MFA_KEY_FILE, USSP_RECORDS_DIR
#   USSP_WRITER_HOLD_ROWS                 bounded for tsdb-writer's memory limit
#   USSP_*_STREAM_MAX_BYTES, USSP_*_BUCKET_MAX_BYTES   bounded within the NATS store
#   USSP_CONF_STREAM_MAX_BYTES, USSP_TRK_STREAM_MAX_BYTES, USSP_MAN_STREAM_MAX_BYTES,
#   USSP_PEER_STREAM_MAX_BYTES, USSP_ALRT_STREAM_MAX_BYTES, USSP_IDENT_STREAM_MAX_BYTES,
#   USSP_INTENT_STREAM_MAX_BYTES, USSP_CIS_STREAM_MAX_BYTES, USSP_TRAFFIC_STREAM_MAX_BYTES,
#   USSP_INGEST_STREAM_MAX_BYTES, USSP_FLIGHT_STREAM_MAX_BYTES,
#   USSP_CIS_CURRENT_BUCKET_MAX_BYTES, USSP_POLICY_BUCKET_MAX_BYTES,
#   USSP_SOURCE_CONTROL_BUCKET_MAX_BYTES, USSP_REGISTRY_VALIDITY_BUCKET_MAX_BYTES,
#   USSP_CLIENT_BINDINGS_BUCKET_MAX_BYTES, USSP_INTENT_ACTIVE_BUCKET_MAX_BYTES,
#   USSP_TELEMETRY_SEEN_BUCKET_MAX_BYTES, USSP_RID_ISA_NOTIFICATIONS_BUCKET_MAX_BYTES,
#   USSP_CONFORMANCE_STATE_BUCKET_MAX_BYTES, USSP_PROXIMITY_STATE_BUCKET_MAX_BYTES,
#   USSP_SESSIONS_LIVE_BUCKET_MAX_BYTES, USSP_RECORD_HOLDS_BUCKET_MAX_BYTES,
#   USSP_RID_DP_SUBSCRIPTIONS_BUCKET_MAX_BYTES, USSP_MONITOR_STATUS_BUCKET_MAX_BYTES,
#   USSP_FLIGHT_BINDING_BUCKET_MAX_BYTES, USSP_JWKS_CACHE_BUCKET_MAX_BYTES
#   USSP_PG_URL, USSP_TS_URL, USSP_NATS_URL  secrets/<process>.env: one NATS
#                                         user per process, only the DSNs it opens
#   USSP_CERTIFICATE_ID                   secrets/certificate.env, copied from the
#                                         authority's issue answer by uspace-deploy's
#                                         scripts/ussp-certificate.sh
#   USSP_NATS_CREDS                       unused: the URL carries the process's user

# ---- identity --------------------------------------------------------------

# The USSP code the authority assigned in this USSP's certificate (M8,
# certificates.code): one to eight upper-case letters and digits. It
# names this USSP's client at the authority, ussp-<code>-01, and the
# authority registers no other form; deploy.sh refuses another shape.
USSP_SYSTEM_ID=STG01
# Hosts this USSP accepts as a token's aud (M18): its public host first.
USSP_AUDIENCES=${USSP_HOST}
# iss of this USSP's own tokens (default https:// and the first audience).
USSP_ISSUER_URL=https://${USSP_HOST}
# This USSP's published base URL (uss_base_url in the DSS).
USSP_USS_BASE_URL=https://${USSP_HOST}
# The previous issuer key during a rotation (published, never used to
# sign); the file goes in secrets/keys/ and is named here while it lasts.
# USSP_ISSUER_PREVIOUS_KEY_FILE=/run/secrets/ussp/issuer-previous.pem

# ---- tokens ----------------------------------------------------------------

# Allow-listed issuers as iss=jwks_url, comma-separated. The first is the
# token service for outgoing calls (the authority's). Not this USSP's own
# issuer: api refuses to start when it is listed, and staging.yaml appends
# it for telemetry-ingest and traffic-ws. The lab issuer is appended
# (,https://${LAB_HOST}=https://${LAB_HOST}/.well-known/jwks.json) only
# once it runs.
USSP_TOKEN_ISSUERS=https://${AUTHORITY_HOST}=https://${AUTHORITY_HOST}/.well-known/jwks.json
# How long an issuer's JWKS kept in jwks_cache verifies its tokens when a
# process starts while that issuer cannot be fetched; 0 keeps none
# (spec 05 section 6 default 24 h, pending GCAA).
# USSP_JWKS_CACHE_MAX_AGE_S=86400
# The client secret of ussp-<code>-01 at the first issuer, for outgoing
# calls. The authority shows it once, in the answer to the certificate's
# issue; scripts/ussp-certificate.sh (uspace-deploy) writes it to
# secrets/keys/client.secret. Uncomment this line then: deploy.sh refuses
# the file without the line and the line without the file.
# USSP_TOKEN_CLIENT_SECRET_FILE=/run/secrets/ussp/client.secret
# Issuers of CIS change notifications (the CISP, the ANSP) as iss=jwks_url.
USSP_CIS_NOTIFY_ISSUERS=https://${CISP_HOST}=https://${CISP_HOST}/.well-known/jwks.json,https://${ANSP_HOST}=https://${ANSP_HOST}/.well-known/jwks.json
# The CIS publishers' keys: a dataset version is used only when its
# publisher's signature verifies (the authority for zones, U-space
# airspace and the USSP list; the ANSP for restrictions).
USSP_CIS_PUBLISHER_KEYS=authority=https://${AUTHORITY_HOST}/.well-known/jwks.json,ansp=https://${ANSP_HOST}/.well-known/jwks.json
# How old a publisher signature may be when this USSP first reads its
# version (default 366 days).
# USSP_CIS_PUBLISHER_SIG_MAX_AGE_S=31622400
# The ANSP's degraded direct delivery (02 F2 failure rule, M5): the
# restrictions held from it and the pulls waiting for it, and how long
# one that is over is kept and a failed pull retried (pending GCAA: the
# spec names no figure; 24 h is 02 F3's notification retry window).
# USSP_CIS_DIRECT_MAX=500
# USSP_CIS_DIRECT_KEEP_S=86400

# ---- peers -----------------------------------------------------------------

USSP_AUTHORITY_BASE_URL=https://${AUTHORITY_HOST}
USSP_CISP_BASE_URL=https://${CISP_HOST}
USSP_ANSP_BASE_URL=https://${ANSP_HOST}
# The InterUSS DSS (the lab's on staging); its host is the outgoing aud.
USSP_DSS_BASE_URL=https://${LAB_HOST}
# The ANSP's manned-traffic stream (F4); unset means no manned traffic,
# shown as unavailable.
USSP_ANSP_STREAM_URL=wss://${ANSP_HOST}/v1/manned-traffic/stream
# Box of the CIS change subscription (min_lng,min_lat,max_lng,max_lat);
# empty is everywhere.
# USSP_CIS_BBOX=
# Period of the conditional pull of every CIS dataset (spec 02 F3: at
# most 60 s).
# USSP_CIS_RECONCILE_S=60
# on: every intent that needs an authorisation is deconflicted through
# the DSS, outside U-space airspace too.
# USSP_DSS_FOR_ALL=off
# The optional WS /v1/authority/flights push (D12), off by default.
# USSP_AUTHORITY_PUSH=off

# ---- mTLS towards the ANSP (M25) -------------------------------------------

# required in production; off on the staging droplet and in the lab,
# where every status period logs it at error level (the lab's simulated
# peers have no certificate).
USSP_MTLS_MODE=off
# With required: the client certificate, its key and the ANSP's CA,
# placed in secrets/keys/.
# USSP_MTLS_CERT_FILE=/run/secrets/ussp/mtls.pem
# USSP_MTLS_KEY_FILE=/run/secrets/ussp/mtls.key
# USSP_MTLS_CA_FILE=/run/secrets/ussp/mtls-ca.pem

# ---- browsers --------------------------------------------------------------

# Origin allow-list of browser WebSocket upgrades (M22).
USSP_WS_ALLOWED_ORIGINS=https://${USSP_HOST}
# Portal and console sessions: at most 12 h (M20), ended after idling.
# USSP_SESSION_TTL_S=43200
# USSP_SESSION_IDLE_S=1800
# Sign-in protection, per username (kept in the database) and per client
# address (per process).
# USSP_LOGIN_LOCKOUT_AFTER=10
# USSP_LOGIN_LOCKOUT_S=900
# USSP_LOGIN_RATE_PER_MIN=30
# USSP_TOKEN_RATE_PER_MIN=60
# USSP_REGISTRY_RATE_PER_MIN=60

# ---- ground and inputs -----------------------------------------------------

# The EGM2008 grid under USSP_GROUND_DIR (mounted at /srv/ground).
USSP_GEOID_FILE=/srv/ground/egm2008-2_5.pgm
# Terrain tiles: no pinned source is published yet.
# USSP_TERRAIN_DIR=/srv/ground/tiles
# Weather (Art. 12): awc:<base URL>. Unset, GET /v1/weather answers 503
# and every decision carries weather_unavailable. Whether GCAA requires
# the service and names a trusted source is pending GCAA (§15.1 Q12).
# USSP_WEATHER_SOURCE=
# The e-conspicuity receiver feed and its id; unset means no receiver.
# USSP_ADSB_SOURCE=
# USSP_ADSB_RECEIVER_ID=adsb-rx-1
# Box of the manned and peer inputs; empty is every U-space airspace of
# the CIS, padded.
# USSP_TRAFFIC_INPUT_BBOX=
# Cells this monitor instance owns (one instance owns every cell, Q15).
# USSP_CELL_OWNERSHIP=all

# ---- occurrences (spec 02 §1) ----------------------------------------------

# Tries of one occurrence report before it fails and is an alarm on the
# console, and the longest wait between two: pending GCAA (the spec's
# bounded backoff).
USSP_OCCURRENCE_MAX_ATTEMPTS=50
USSP_OCCURRENCE_BACKOFF_MAX_S=600

# ---- backups (deploy/backup.sh, not read by the processes) -----------------

# How long the nightly backups are kept on the host, and how many days of
# the time-series hypertables each one exports (the spec's 7-day
# uncompressed window, 05 §4): national choices, pending GCAA.
USSP_BACKUP_KEEP_DAYS=14
USSP_BACKUP_TS_DAYS=7

# ---- process ---------------------------------------------------------------

USSP_LOG_LEVEL=info
# OTLP/HTTP trace endpoint; tracing is off when unset.
# USSP_OTLP_URL=
# Seconds between status lines with every counter and dependency.
# USSP_STATUS_INTERVAL_S=60
# Bound on the drain after SIGTERM.
# USSP_SHUTDOWN_TIMEOUT_S=15
# How long api and tsdb-writer wait at start for migrate to bring their
# schema to the version they need, then refuse to start naming both.
# USSP_SCHEMA_WAIT_S=60
# tsdb-writer: how long rows may wait in memory while writes succeed.
# USSP_WRITER_QUEUE_S=10
# Request bounds.
# USSP_HTTP_MAX_BODY_BYTES=1048576
# USSP_HTTP_READ_HEADER_TIMEOUT_S=5
# USSP_READINESS_CHECK_TIMEOUT_MS=2000
# How long each stream keeps a message (its byte bound is staging.yaml's).
# USSP_CONF_STREAM_MAX_AGE_S=172800
# USSP_TRK_STREAM_MAX_AGE_S=3600
# USSP_MAN_STREAM_MAX_AGE_S=3600
# USSP_PEER_STREAM_MAX_AGE_S=3600
# USSP_ALRT_STREAM_MAX_AGE_S=604800
# USSP_IDENT_STREAM_MAX_AGE_S=86400
# USSP_INTENT_STREAM_MAX_AGE_S=2592000
# USSP_CIS_STREAM_MAX_AGE_S=2592000
# USSP_TRAFFIC_STREAM_MAX_AGE_S=86400
# USSP_INGEST_STREAM_MAX_AGE_S=600
# USSP_FLIGHT_STREAM_MAX_AGE_S=2592000
