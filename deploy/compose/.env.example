# Copy to deploy/compose/.env (git-ignored) and replace every value, or
# let `make compose-up` write .env with random values on first use.
# Use letters and digits only: the values are embedded in URLs.
POSTGRES_PASSWORD=change-me
USSP_PG_API_PASSWORD=change-me
USSP_PG_TSDB_PASSWORD=change-me
USSP_NATS_API_PASSWORD=change-me
USSP_NATS_TELEMETRY_INGEST_PASSWORD=change-me
USSP_NATS_RID_SP_PASSWORD=change-me
USSP_NATS_MONITOR_PASSWORD=change-me
USSP_NATS_TRAFFIC_WS_PASSWORD=change-me
USSP_NATS_DSS_SYNC_PASSWORD=change-me
USSP_NATS_TSDB_WRITER_PASSWORD=change-me
# Optional: the image tag (default dev, built locally by compose-up).
# USSP_IMAGE_TAG=dev
