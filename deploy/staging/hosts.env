# The staging droplet's public hosts: the only file of this repository
# that names the staging domain (spec 06 §4; scripts/check-hostnames.sh
# fails on it anywhere else but Markdown). uspace-deploy's
# config/hosts.env holds the same values and is what the droplet reads;
# this copy is what deploy/deploy.sh is given when it is run from a
# checkout (--env-file deploy/staging/hosts.env).
USSP_HOST=uspace-ussp.chikox.net
AUTHORITY_HOST=uspace-authority.chikox.net
CISP_HOST=uspace-cisp.chikox.net
ANSP_HOST=uspace-ansp.chikox.net
LAB_HOST=uspace-lab.chikox.net
